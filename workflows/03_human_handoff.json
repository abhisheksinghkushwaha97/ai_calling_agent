          "mappingMode": "defineBelow",
          "value": {
            "Status": "Transferred",
            "Handoff_Reason": "={{ $('Extract Handoff Data').item.json.handoffReason }}",
            "Handoff_Time": "={{ $('Extract Handoff Data').item.json.handoffTime }}"
          }
        }
      },
      "id": "update-call-log",
      "name": "Update Call Log",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [1790, 300],
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-creds",
          "name": "Airtable Token"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"callSid\": \"{{ $('Extract Handoff Data').item.json.callSid }}\",\n  \"handoffLogged\": true,\n  \"smsSent\": true\n}",
        "options": {}
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2010, 300]
    }
  ],
