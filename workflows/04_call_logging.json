    {
      "parameters": {
        "jsCode": "// Calculate call cost estimate\nconst durationSeconds = $('Extract Call End Data').item.json.callDuration || 0;\nconst durationMinutes = Math.ceil(durationSeconds / 60);\n\n// Cost estimates (approximate)\nconst twilioCostPerMin = 0.02;\nconst openAICostPerCall = 0.02;\nconst totalCost = (durationMinutes * twilioCostPerMin) + openAICostPerCall;\n\n// Calculate peak hour\nconst callEnd = new Date();\nconst hour = callEnd.getHours();\nconst isPeakHour = (hour >= 11 && hour <= 14) || (hour >= 17 && hour <= 21);\n\nreturn {\n  durationMinutes,\n  estimatedCost: totalCost.toFixed(4),\n  isPeakHour,\n  hourOfDay: hour,\n  dayOfWeek: callEnd.toLocaleDateString('en-US', { weekday: 'long' })\n};"
      },
      "id": "calculate-metrics",
      "name": "Calculate Call Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1350, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "base": {
