        "table": {
          "__rl": true,
          "mode": "id",
          "value": "Call_Logs"
        },
        "id": "={{ $('Find Call Record').item.json.id }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Duration_Minutes": "={{ $json.durationMinutes }}",
            "Estimated_Cost": "={{ $json.estimatedCost }}",
            "Is_Peak_Hour": "={{ $json.isPeakHour }}",
            "Hour_Of_Day": "={{ $json.hourOfDay }}",
            "Day_Of_Week": "={{ $json.dayOfWeek }}"
          }
        }
      },
      "id": "update-call-metrics",
