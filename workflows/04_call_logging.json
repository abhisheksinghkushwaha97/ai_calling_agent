    {
      "parameters": {
        "jsCode": "// Parse and format order for storage\nconst orderData = JSON.parse($input.first().json.order || '[]');\nconst callerPhone = $input.first().json.callerPhone;\nconst orderTime = $input.first().json.orderTime;\n\n// Calculate order total (would need menu prices from Airtable)\nlet orderTotal = 0;\nconst formattedItems = orderData.map(item => {\n  // Price lookup would happen here in production\n  const estimatedPrice = 12.99; // Placeholder\n  orderTotal += item.quantity * estimatedPrice;\n  return `${item.quantity}x ${item.item}`;\n});\n\n// Generate order number\nconst orderNumber = `ORD-${Date.now().toString().slice(-6)}`;\n\nreturn {\n  orderNumber,\n  formattedItems: formattedItems.join(', '),\n  itemCount: orderData.length,\n  estimatedTotal: orderTotal.toFixed(2),\n  orderSummary: `Order #${orderNumber}: ${formattedItems.join(', ')} - Est. $${orderTotal.toFixed(2)}`\n};"
      },
