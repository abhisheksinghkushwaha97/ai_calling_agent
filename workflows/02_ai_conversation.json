        "responseBody": "=<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Response>\n    <Say voice=\"Polly.Joanna\">{{ $('Generate AI Response').item.json.message.content.replace('[ORDER_COMPLETE]', '') }} Your order has been placed. Thank you for calling {{ $('Prepare AI Context').item.json.restaurantName }}!</Say>\n    <Hangup/>\n</Response>",
        "options": {
