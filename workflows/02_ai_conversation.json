    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Response>\n    <Say voice=\"Polly.Joanna\">{{ $json.message.content.replace('[TRANSFER_TO_HUMAN]', 'Let me connect you with our staff right away.').replace('[ORDER_COMPLETE]', '') }}</Say>\n    <Gather input=\"speech\" timeout=\"5\" speechTimeout=\"auto\" action=\"{{ $env.N8N_WEBHOOK_URL }}/webhook/ai-conversation?callSid={{ $('Extract Speech Data').item.json.callSid }}&amp;callerPhone={{ $('Extract Speech Data').item.json.callerPhone }}\" method=\"POST\">\n        <Say voice=\"Polly.Joanna\"></Say>\n    </Gather>\n    <Redirect method=\"POST\">{{ $env.N8N_WEBHOOK_URL }}/webhook/ai-conversation?callSid={{ $('Extract Speech Data').item.json.callSid }}&amp;callerPhone={{ $('Extract Speech Data').item.json.callerPhone }}</Redirect>\n</Response>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/xml"
              }
            ]
          }
        }
      },
