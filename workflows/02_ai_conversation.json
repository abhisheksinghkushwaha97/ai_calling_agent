    {
      "parameters": {
        "operation": "update",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.AIRTABLE_BASE_ID }}"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "Conversation_State"
        },
        "id": "={{ $('Get Conversation State').item.json.id }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Conversation_History": "={{ JSON.stringify([...JSON.parse($('Prepare AI Context').item.json.conversationHistory || '[]'), { role: 'user', content: $('Extract Speech Data').item.json.speechResult }, { role: 'assistant', content: $('Generate AI Response').item.json.message.content }]) }}",
            "Updated_At": "={{ $now.toISO() }}"
          }
        }
      },
      "id": "update-conversation-state",
      "name": "Update Conversation State",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [2670, 400],
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-creds",
          "name": "Airtable Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract order items from AI response and update order\nconst aiResponse = $('Generate AI Response').item.json.message.content;\nconst currentOrder = JSON.parse($('Prepare AI Context').item.json.currentOrder || '[]');\nconst speechResult = $('Extract Speech Data').item.json.speechResult;\n\n// Simple order extraction logic - can be enhanced\nconst orderPatterns = [\n  /added? (\\d+)?\\s*(.+?) to your order/i,\n  /that's (\\d+)?\\s*(.+?) added/i,\n  /(\\d+)?\\s*(.+?) - got it/i\n];\n\nlet newItems = [];\nfor (const pattern of orderPatterns) {\n  const match = aiResponse.match(pattern);\n  if (match) {\n    newItems.push({\n      quantity: parseInt(match[1]) || 1,\n      item: match[2].trim(),\n      addedAt: new Date().toISOString()\n    });\n  }\n}\n\nconst updatedOrder = [...currentOrder, ...newItems];\n\nreturn {\n  updatedOrder: JSON.stringify(updatedOrder),\n  orderCount: updatedOrder.length\n};"
      },
      "id": "extract-order-items",
      "name": "Extract Order Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2450, 400]
    }
